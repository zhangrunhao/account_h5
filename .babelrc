{
  "presets": [
    "@babel/preset-env",
    "@babel/preset-react"
  ],
  "plugins": [
    [
      "babel-plugin-styled-components",
      {
        "displayName": true,
        "fileName": true
      }
    ],
    [
      "import",
      {
      "libraryName": "antd-mobile",
      "libraryDirectory": "lib"
      },
      "antd-mobile"
    ]
  ]
}